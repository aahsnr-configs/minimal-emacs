---
interface Props {
  items: Array<{ vscode: string; emacs: string }>;
}

const { items } = Astro.props;
---

<div class="sec-title">Behavioral Parity Matrix</div>
<div class="tbl-wrap">
  <table class="tbl">
    <thead>
      <tr>
        <th>VS Code Behavior</th>
        <th>Emacs Equivalent</th>
      </tr>
    </thead>
    <tbody>
      {items.map((item) => (
        <tr>
          <td set:html={item.vscode} />
          <td set:html={item.emacs} />
        </tr>
      ))}
    </tbody>
  </table>
</div>
