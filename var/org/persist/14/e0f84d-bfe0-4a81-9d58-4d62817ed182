   Capture templates prepended to the global list\12\12Example — register a project with its own roam DB and capture templates:\12\12  (my/register-project-org-context \\\"~/code/myproject/\\\"\12    :name        \\\"myproject\\\"\12    :roam-dir    (expand-file-name \\\"~/code/myproject/notes/\\\")\12    :roam-db     (expand-file-name \\\"~/code/myproject/notes/org-roam.db\\\")\12    :gtd-dir     (expand-file-name \\\"~/code/myproject/gtd/\\\")\12    :agenda-files (list (expand-file-name \\\"~/code/myproject/\\\")\12                        (expand-file-name \\\"~/code/myproject/gtd/\\\"))\12    :capture-tpls\12    '((\\\"P\\\" \\\"MyProject\\\")\12      (\\\"Pj\\\" \\\"MyProject Journal\\\" entry\12       (file+olp+datetree \\\"~/code/myproject/journal.org\\\")\12       \\\"* %<%H:%M> %?\\\\n\\\" :empty-lines 1)))\"\12  (let* ((truename (file-truename (expand-file-name root)))\12         ;; Default :name to the last path component if not supplied\12         (name (or (plist-get plist :name)\12                   (file-name-nondirectory (directory-file-name truename))))\12         (ctx (plist-put plist :name name)))\12    ;; Replace any existing entry for this root\12    (setq my/project-org-contexts\12          (cons (cons truename ctx)\12                (assoc-delete-all truename my/project-org-contexts)))))\12\12;;; ── State ─────────────────────────────────────────────────────────────────\12(defvar my/global-org-context nil\12  \"Snapshot of the global org context taken on first project activation.\12nil means no project has ever been activated this session.\12Plist shape mirrors `my/project-org-contexts' entries, plus:\12  :capture-tpls — the full `org-capture-templates' list at snapshot time.\")\12\12(defvar my/active-org-project nil\12  \"Truename root of the currently active project, or nil for global.\")\12\12;;; ── Snapshot ──────────────────────────────────────────────────────────────\12(defun my/project-org--snapshot ()\12  \"Save current global org varia